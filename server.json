{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.tylern91/obsidian-mcp-server",
  "description": "Filesystem-based MCP server for Obsidian vaults — read, search, and edit notes, no app required.",
  "title": "Obsidian MCP Server",
  "websiteUrl": "https://github.com/tylern91/obsidian-mcp-server",
  "repository": {
    "url": "https://github.com/tylern91/obsidian-mcp-server",
    "source": "github"
  },
  "version": "0.3.0",
  "packages": [
    {
      "registryType": "mcpb",
      "identifier": "https://github.com/tylern91/obsidian-mcp-server/releases/download/v0.3.0/obsidian-mcp-v0.3.0.mcpb",
      "version": "0.3.0",
      "fileSha256": "0305a1e67b2b7ca3a8b6306c64299ca41c52754e3a92814d065d091d91b7cac6",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "named",
          "name": "--vault",
